namespace TreeSitter {

	[CCode (cname = "TSStateId", has_type_id = false, default_value = "0")]
	[SimpleType]
	[IntegerType (rank = 4)]
	public struct StateId : uint16 {}

	[CCode (cname = "TSSymbol", has_type_id = false, default_value = "0")]
