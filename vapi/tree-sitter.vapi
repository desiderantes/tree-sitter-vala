	/**
	 * A position in a text document in terms of rows and columns.
	 */
	[SimpleType]
	[CCode (cname = "TSPoint", has_type_id = false)]
	public struct Point {
		public uint32 row;
		public uint32 column;

		public Point (uint32 row = 0, uint32 column = 0) {
			this.row = row;
			this.column = column;
		}
	}

	/**
	 * A range of text in terms of byte offsets and (row, column) positions.
	 */
	[SimpleType]
	[CCode (cname = "TSRange", has_type_id = false)]
	public struct Range {
		public Point start_point;
		public Point end_point;
		public uint32 start_byte;
		public uint32 end_byte;
	}

	/**
	 * A summary of a change to a text document.
	 *
	 * The `start_byte` and `start_point` values must be less than or equal to the
	 * `old_end_byte` and `old_end_point` values, respectively. Passing an edit
	 * that violates these invariants may produce nonsensical results.
	 */
	[CCode (cname = "TSInputEdit", has_type_id = false)]
	public struct InputEdit {
		public uint32 start_byte;
		public uint32 old_end_byte;
		public uint32 new_end_byte;
		public Point start_point;
		public Point old_end_point;
		public Point new_end_point;

		/**
		 * Edit a node to keep it in sync with source code that has been edited.
		 *
		 * This is only needed for nodes retrieved before the edit; nodes retrieved
		 * from a tree after {@link Tree.edit} already reflect it.
		 */
		[CCode (cname = "ts_node_edit", instance_pos = -1)]
		public void apply_to_node (ref Node node);

		/**
		 * Edit a point (and its byte offset) to keep it in sync with source code
		 * that has been edited.
		 */
		[CCode (cname = "ts_point_edit", instance_pos = -1)]
		public void apply_to_point (ref Point point, ref uint32 point_byte);

		/**
		 * Edit a range to keep it in sync with source code that has been edited.
		 */
		[CCode (cname = "ts_range_edit", instance_pos = -1)]
		public void apply_to_range (ref Range range);
	}

	/**
	 * The metadata associated with a language.
	 *
	 * Currently, this metadata can be used to check the [Semantic Version](https://semver.org/)
	 * of the language. This version information should be used to signal if a given parser might
	 * be incompatible with existing queries when upgrading between major versions, or minor versions
	 * if it's in zerover.
	 */
	[SimpleType]
	[CCode (cname = "TSLanguageMetadata", has_type_id = false)]
	public struct LanguageMetadata {
		public uint8 major_version;
		public uint8 minor_version;
		public uint8 patch_version;
	}

	/**
	 * A capture in a query match.
	 */
	[SimpleType]
	[CCode (cname = "TSQueryCapture", has_type_id = false)]
	public struct QueryCapture {
		public Node node;
		public uint32 index;
	}

	/**
	 * A match returned by executing a query.
	 */
	[SimpleType]
	[CCode (cname = "TSQueryMatch", has_type_id = false)]
	public struct QueryMatch {
		public uint32 id;
		public uint16 pattern_index;
		public uint16 capture_count;
		[CCode (array_length_cname = "capture_count")]
		public unowned QueryCapture[] captures;
	}

	/**
	 * A single step in a query predicate.
	 */
	[SimpleType]
	[CCode (cname = "TSQueryPredicateStep", has_type_id = false)]
	public struct QueryPredicateStep {
		public QueryPredicateStepType type;
		public uint32 value_id;
	}

	/**
	 * A callback function to decode a single code point from a string of bytes.
	 */
	[CCode (cname = "TSDecodeFunction", has_target = false)]
	public delegate uint32 DecodeFunction ([CCode (array_length_type = "uint32_t", type = "const uint8_t *")] uint8[] bytes, out int32 code_point);

	/**
	 * A callback function to retrieve a chunk of text at a given byte offset and position.
	 *
	 * Return the bytes starting at `byte_index`, or null / an empty array at the end
	 * of the document. The returned buffer must stay alive until the next call.
	 */
	[CCode (cname = "ValaTSInputReadFunc", has_typedef = false, has_target = true, instance_pos = 0, array_length_type = "uint32_t")]
	public delegate unowned uint8[]? InputReadFunc (uint32 byte_index, Point position);

	/**
	 * Custom input interface for reading source code chunks.
	 *
	 * The `read` callback may be a closure; it is not owned by this struct, so it
	 * must outlive the parse call.
	 */
	[SimpleType]
	[CCode (cname = "TSInput", has_type_id = false)]
	public struct Input {
		[CCode (delegate_target_cname = "payload")]
		public unowned InputReadFunc read;
		public InputEncoding encoding;
		public DecodeFunction? decode;
	}

	/**
	 * A callback function for receiving parser log messages.
	 */
	[CCode (cname = "ValaTSLogFunc", has_typedef = false, has_target = true, instance_pos = 0)]
	public delegate void LogFunc (LogType log_type, string buffer);

	/**
	 * A logger for receiving parser debugging messages.
	 *
	 * The `log` callback may be a closure; it is not owned by this struct, so it
	 * must outlive its use by the parser. Set it to null to disable logging.
	 */
	[SimpleType]
	[CCode (cname = "TSLogger", has_type_id = false)]
	public struct Logger {
		[CCode (delegate_target_cname = "payload")]
		public unowned LogFunc? log;
	}

	/**
	 * The state of a parse in progress.
	 */
	[SimpleType]
	[CCode (cname = "TSParseState", has_type_id = false)]
	public struct ParseState {
		public void* payload;
		public uint32 current_byte_offset;
		public bool has_error;
	}

	/**
	 * A callback function to report parsing progress and allow cancellation.
	 */
	[CCode (cname = "ValaTSParseProgressFunc", has_typedef = false, has_target = false)]
	public delegate bool ParseProgressFunc (ref ParseState state);

	/**
	 * Options for parsing.
	 */
	[SimpleType]
	[CCode (cname = "TSParseOptions", has_type_id = false)]
	public struct ParseOptions {
		/**
		 * Arbitrary data made available to the callback as `state.payload`.
		 */
		public void* payload;
		/**
		 * Return true to cancel parsing.
		 */
		public unowned ParseProgressFunc? progress_callback;
	}

	/**
	 * The state of a query execution in progress.
	 */
	[SimpleType]
	[CCode (cname = "TSQueryCursorState", has_type_id = false)]
	public struct QueryCursorState {
		public void* payload;
		public uint32 current_byte_offset;
	}

	/**
	 * A callback function to report query progress and allow cancellation.
	 */
	[CCode (cname = "ValaTSQueryProgressFunc", has_typedef = false, has_target = false)]
	public delegate bool QueryProgressFunc (ref QueryCursorState state);

	/**
	 * Options for query execution.
	 */
	[CCode (cname = "TSQueryCursorOptions", has_type_id = false)]
	public struct QueryCursorOptions {
		/**
		 * Arbitrary data made available to the callback as `state.payload`.
		 */
		public void* payload;
		/**
		 * Return true to cancel query execution.
		 */
		public unowned QueryProgressFunc? progress_callback;
	}

	/**
	 * An opaque object that defines how to parse a particular language.
	 */
	[Compact]
	[CCode (cname = "const TSLanguage", has_type_id = false, free_function = "ts_language_delete")]
	public class Language {
		/**
		 * Get another reference to the given language.
		 */
		[CCode (cname = "ts_language_copy")]
		public Language dup ();

		/**
		 * Get the number of distinct node types in the language.
		 */
		public uint32 symbol_count ();

		/**
		 * Get the number of valid parse states in this language.
		 */
		public uint32 state_count ();

		/**
		 * Get a node type string for the given numerical id.
		 */
		public unowned string? symbol_name (Symbol symbol);

		/**
		 * Get the numerical id for the given node type string.
		 */
		[CCode (cname = "ts_language_symbol_for_name")]
		private Symbol _symbol_for_name ([CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] name, bool is_named);

		[CCode (cname = "vala_ts_language_symbol_for_name")]
		public Symbol symbol_for_name (string name, bool is_named = true) {
			return _symbol_for_name (name.data, is_named);
		}

		/**
		 * Get the number of distinct field names in the language.
		 */
		public uint32 field_count ();

		/**
		 * Get the field name string for the given numerical id.
		 */
		public unowned string? field_name_for_id (FieldId id);

		/**
		 * Get the numerical id for the given field name string.
		 */
		[CCode (cname = "ts_language_field_id_for_name")]
		private FieldId _field_id_for_name ([CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] name);

		[CCode (cname = "vala_ts_language_field_id_for_name")]
		public FieldId field_id_for_name (string name) {
			return _field_id_for_name (name.data);
		}

		/**
		 * Check whether the given node type id belongs to named nodes, anonymous nodes,
		 * or hidden nodes.
		 */
		public SymbolType symbol_type (Symbol symbol);

		/**
		 * Get the ABI version number for this language.
		 */
		public uint32 abi_version ();

		/**
		 * Get the metadata for this language.
		 */
		public unowned LanguageMetadata? metadata ();

		/**
		 * Get the next parse state.
		 */
		public StateId next_state (StateId state, Symbol symbol);

		/**
		 * Get the name of this language. This returns NULL in older parsers.
		 */
		public unowned string? name ();

		/**
		 * Check if the language came from a Wasm module.
		 */
		public bool is_wasm ();

		/**
		 * Get a list of all supertype symbols for the language.
		 */
		[CCode (cname = "ts_language_supertypes", array_length_type = "uint32_t")]
		public unowned Symbol[] supertypes ();

		/**
		 * Get a list of all subtype symbol ids for a given supertype symbol.
		 */
		[CCode (cname = "ts_language_subtypes", array_length_type = "uint32_t")]
		public unowned Symbol[] subtypes (Symbol supertype);
	}

	/**
	 * A store for managing WebAssembly language modules.
	 */
	[Compact]
	[CCode (cname = "TSWasmStore", has_type_id = false, free_function = "ts_wasm_store_delete")]
	public class WasmStore {
		[SimpleType]
		[CCode (cname = "TSWasmError", has_type_id = false)]
		private struct RawError {
			public WasmErrorKind kind;
			public char* message;
		}

		[CCode (cname = "ts_wasm_store_new")]
		private static WasmStore? _create (void* engine, out RawError error);

		/**
		 * Create a new Wasm store for the given `wasm_engine_t`.
		 *
		 * Returns null on failure, with the reason in `error_kind` / `error_message`.
		 * Requires a tree-sitter library built with Wasm support.
		 */
		[CCode (cname = "vala_ts_wasm_store_new")]
		public static WasmStore? create (void* engine, out WasmErrorKind error_kind = null, out string? error_message = null) {
			RawError error = {};
			WasmStore? store = _create (engine, out error);
			error_kind = error.kind;
			error_message = error.message != null ? ((string) error.message).dup () : null;
			GLib.free (error.message);
			return store;
		}

		/**
		 * Get the number of languages instantiated in the given Wasm store.
		 */
		public size_t language_count ();

		[CCode (cname = "ts_wasm_store_load_language")]
		private Language? _load_language (string name, [CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] wasm, out RawError error);

		/**
		 * Create a language from a buffer of Wasm bytecode.
		 *
		 * Returns null on failure, with the reason in `error_kind` / `error_message`.
		 */
		[CCode (cname = "vala_ts_wasm_store_load_language")]
		public Language? load_language (string name, uint8[] wasm, out WasmErrorKind error_kind = null, out string? error_message = null) {
			RawError error = {};
			Language? language = _load_language (name, wasm, out error);
			error_kind = error.kind;
			error_message = error.message != null ? ((string) error.message).dup () : null;
			GLib.free (error.message);
			return language;
		}
	}

	/**
	 * An iterator for inspecting valid lookahead symbols in a given parse state.
	 *
	 * Lookahead iterators can be useful to generate suggestions and improve syntax
	 * error diagnostics.
	 */
	[Compact]
	[CCode (cname = "TSLookaheadIterator", has_type_id = false, free_function = "ts_lookahead_iterator_delete")]
	public class LookaheadIterator {
		/**
		 * Create a new lookahead iterator for the given language and parse state.
		 *
		 * This returns null if state is invalid for the language.
		 */
		[CCode (cname = "ts_lookahead_iterator_new")]
		public static LookaheadIterator? create (Language language, StateId state);

		/**
		 * Reset the lookahead iterator to another state.
		 *
		 * This returns true if the iterator was reset to the given state and false
		 * otherwise.
		 */
		public bool reset_state (StateId state);

		/**
		 * Reset the lookahead iterator.
		 *
		 * This returns true if the language was set successfully and false
		 * otherwise.
		 */
		public bool reset (Language language, StateId state);

		/**
		 * Get the current language of the lookahead iterator.
		 */
		public unowned Language language ();

		/**
		 * Advance the lookahead iterator to the next symbol.
		 *
		 * This returns true if there is a new symbol and false otherwise.
		 */
		public bool next ();

		/**
		 * Get the current symbol of the lookahead iterator.
		 */
		public Symbol current_symbol ();

		/**
		 * Get the current symbol type of the lookahead iterator as a null terminated
		 * string.
		 */
		public unowned string? current_symbol_name ();
	}

	/**
	 * A stateful object that is used to produce a syntax tree from source code.
	 */
	[Compact]
	[CCode (cname = "TSParser", has_type_id = false, free_function = "ts_parser_delete")]
	public class Parser {
		/**
		 * Create a new parser.
		 */
		[CCode (cname = "ts_parser_new")]
		public Parser ();

		/**
		 * The parser's current language. Use {@link set_language} to change it.
		 */
		public unowned Language? language {
			[CCode (cname = "ts_parser_language")]
			get;
		}

		/**
		 * Set the language that the parser should use for parsing.
		 *
		 * Returns a boolean indicating whether or not the language was successfully
		 * assigned. True means assignment succeeded. False means there was a version
		 * mismatch: the language was generated with an incompatible version of the
		 * Tree-sitter CLI.
		 */
		public bool set_language (Language language);

		/**
		 * Use the parser to parse source code using a custom input interface.
		 */
		[CCode (cname = "ts_parser_parse")]
		private Tree? _parse (Tree? old_tree, Input input);

		[CCode (cname = "vala_ts_parser_parse")]
		public Tree? parse (Input input, Tree? old_tree = null) {
			return _parse (old_tree, input);
		}

		/**
		 * Use the parser to parse source code using a custom input interface and options.
		 */
		[CCode (cname = "ts_parser_parse_with_options")]
		private Tree? _parse_with_options (Tree? old_tree, Input input, ParseOptions parse_options);

		[CCode (cname = "vala_ts_parser_parse_with_options")]
		public Tree? parse_with_options (Input input, ParseOptions parse_options, Tree? old_tree = null) {
			return _parse_with_options (old_tree, input, parse_options);
		}

		/**
		 * Use the parser to parse raw source code bytes stored in one contiguous buffer.
		 */
		[CCode (cname = "ts_parser_parse_string")]
		private Tree? _parse_bytes (Tree? old_tree, [CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] input);

		[CCode (cname = "vala_ts_parser_parse_bytes")]
		public Tree? parse_bytes ([CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] input, Tree? old_tree = null) {
			return _parse_bytes (old_tree, input);
		}

		/**
		 * Use the parser to parse some source code stored in one contiguous text buffer.
		 */
		[CCode (cname = "vala_ts_parser_parse_string")]
		public Tree? parse_string (string input, Tree? old_tree = null) {
			return _parse_bytes (old_tree, input.data);
		}

		/**
		 * Use the parser to parse raw source code bytes stored in one contiguous buffer
		 * with a given encoding (e.g. UTF-16). Vala strings are always UTF-8, so use
		 * {@link parse_string} for those.
		 */
		[CCode (cname = "ts_parser_parse_string_encoding")]
		private Tree? _parse_bytes_encoding (Tree? old_tree, [CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] input, InputEncoding encoding);

		[CCode (cname = "vala_ts_parser_parse_bytes_encoding")]
		public Tree? parse_bytes_encoding ([CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] input, InputEncoding encoding, Tree? old_tree = null) {
			return _parse_bytes_encoding (old_tree, input, encoding);
		}

		/**
		 * Instruct the parser to start the next parse from the beginning.
		 *
		 * If the parser previously failed because of the progress callback, then
		 * by default, it will resume where it left off on the next call to
		 * `ts_parser_parse` or other parsing functions. If you don't want to resume,
		 * and instead intend to use this parser to parse some other document, you must
		 * call `ts_parser_reset` first.
		 */
		public void reset ();

		/**
		 * The logger that the parser should use during parsing.
		 */
		public Logger logger {
			[CCode (cname = "ts_parser_logger")]
			get;
			[CCode (cname = "ts_parser_set_logger")]
			set;
		}

		/**
		 * Set the ranges of text that the parser should include when parsing.
		 */
		[CCode (cname = "ts_parser_set_included_ranges")]
		public bool set_included_ranges (
			[CCode (array_length_cname = "count", array_length_type = "uint32_t")] Range[] ranges
		);

		/**
		 * Get the ranges of text that the parser will include when parsing.
		 */
		[CCode (cname = "ts_parser_included_ranges", array_length_type = "uint32_t")]
		public unowned Range[] included_ranges ();

		/**
		 * Assign the given Wasm store to the parser. A parser must have a Wasm store
		 * in order to use Wasm languages.
		 */
		public void set_wasm_store (owned WasmStore store);

		/**
		 * Remove the parser's current Wasm store and return it. This returns NULL if
		 * the parser doesn't have a Wasm store.
		 */
		public WasmStore? take_wasm_store ();

		/**
		 * Set the file descriptor to which the parser should write debugging graphs
		 * during parsing. The graphs are formatted in the DOT language.
		 */
		public void print_dot_graphs (int fd);
	}

	/**
	 * A tree that represents the syntactic structure of a source code file.
	 */
	[Compact]
	[CCode (cname = "TSTree", has_type_id = false, free_function = "ts_tree_delete")]
	public class Tree {
		/**
		 * Create a shallow copy of the syntax tree. This is very fast.
		 *
		 * You need to copy a syntax tree in order to use it on more than one thread at
		 * a time, as syntax trees are not thread safe.
		 */
		[CCode (cname = "ts_tree_copy")]
		public Tree dup ();

		/**
		 * Get the root node of the syntax tree.
		 */
		[CCode (cname = "ts_tree_root_node")]
		public Node root_node ();

		/**
		 * Get the language that was used to parse the syntax tree.
		 */
		public unowned Language language ();

		/**
		 * Get the array of included ranges that was used to parse the syntax tree.
		 */
		[CCode (cname = "ts_tree_included_ranges", array_length_type = "uint32_t", free_function = "free")]
		public Range[] included_ranges ();

		/**
		 * Edit the syntax tree to keep it in sync with source code that has been
		 * edited.
		 *
		 * You must describe the edit both in terms of byte offsets and in terms of
		 * (row, column) coordinates.
		 */
		public void edit (InputEdit edit);

		/**
		 * Get the root node of the syntax tree, but with its position
		 * shifted forward by the given offset.
		 */
		[CCode (cname = "ts_tree_root_node_with_offset")]
		public Node root_node_with_offset (uint32 offset_bytes, Point offset_extent);

		/**
		 * Compare an old edited syntax tree to a new syntax tree representing the same
		 * document, returning an array of ranges whose syntactic structure has changed.
		 */
		[CCode (cname = "ts_tree_get_changed_ranges", array_length_type = "uint32_t", free_function = "free")]
		public Range[] get_changed_ranges (Tree new_tree);

		/**
		 * Write a DOT graph describing the syntax tree to the given file descriptor.
		 */
		[CCode (cname = "ts_tree_print_dot_graph")]
		public void print_dot_graph (int file_descriptor);
	}

	/**
	 * A single node within a syntax tree.
	 */
	[SimpleType]
	[CCode (cname = "TSNode", has_type_id = false)]
	public struct Node {
		private uint32 context[4];
		private void* id;
		private void* tree;

		/**
		 * Get the node's type as a null-terminated string.
		 */
		public unowned string type {
			[CCode (cname = "ts_node_type")]
			get;
		}

		/**
		 * Get the node's type as a numerical id.
		 */
		public Symbol symbol {
			[CCode (cname = "ts_node_symbol")]
			get;
		}

		/**
		 * Get the node's language.
		 */
		public unowned Language language {
			[CCode (cname = "ts_node_language")]
			get;
		}

		/**
		 * Get the node's type as it appears in the grammar ignoring aliases as a
		 * null-terminated string.
		 */
		public unowned string grammar_type {
			[CCode (cname = "ts_node_grammar_type")]
			get;
		}

		/**
		 * Get the node's type as a numerical id as it appears in the grammar ignoring
		 * aliases.
		 */
		public Symbol grammar_symbol {
			[CCode (cname = "ts_node_grammar_symbol")]
			get;
		}

		/**
		 * Get the node's start byte.
		 */
		public uint32 start_byte {
			[CCode (cname = "ts_node_start_byte")]
			get;
		}

		/**
		 * Get the node's end byte.
		 */
		public uint32 end_byte {
			[CCode (cname = "ts_node_end_byte")]
			get;
		}

		/**
		 * Get the node's start position in terms of rows and columns.
		 */
		public Point start_point {
			[CCode (cname = "ts_node_start_point")]
			get;
		}

		/**
		 * Get the node's end position in terms of rows and columns.
		 */
		public Point end_point {
			[CCode (cname = "ts_node_end_point")]
			get;
		}

		/**
		 * Get an S-expression representing the node as a string.
		 */
		[CCode (cname = "ts_node_string", free_function = "free")]
		public string to_string ();

		/**
		 * Check if the node is null. Functions like `ts_node_child` and
		 * `ts_node_next_sibling` will return a null node to indicate that no such node
		 * was found.
		 */
		public bool is_null {
			[CCode (cname = "ts_node_is_null")]
			get;
		}

		/**
		 * Check if the node is named. Named nodes correspond to named rules in the
		 * grammar, whereas anonymous nodes correspond to string literals in the
		 * grammar.
		 */
		public bool is_named {
			[CCode (cname = "ts_node_is_named")]
			get;
		}

		/**
		 * Check if the node is missing. Missing nodes are inserted by the parser in
		 * order to recover from certain kinds of syntax errors.
		 */
		public bool is_missing {
			[CCode (cname = "ts_node_is_missing")]
			get;
		}

		/**
		 * Check if the node is extra. Extra nodes represent things like comments,
		 * which are not required by the grammar, but can appear anywhere.
		 */
		public bool is_extra {
			[CCode (cname = "ts_node_is_extra")]
			get;
		}

		/**
		 * Check if a syntax node has been edited.
		 */
		public bool has_changes {
			[CCode (cname = "ts_node_has_changes")]
			get;
		}

		/**
		 * Check if the node is a syntax error or contains any syntax errors.
		 */
		public bool has_error {
			[CCode (cname = "ts_node_has_error")]
			get;
		}

		/**
		 * Check if the node is a syntax error.
		 */
		public bool is_error {
			[CCode (cname = "ts_node_is_error")]
			get;
		}

		/**
		 * Get this node's parse state.
		 */
		public StateId parse_state {
			[CCode (cname = "ts_node_parse_state")]
			get;
		}

		/**
		 * Get the parse state after this node.
		 */
		public StateId next_parse_state {
			[CCode (cname = "ts_node_next_parse_state")]
			get;
		}

		/**
		 * Get the node's immediate parent.
		 */
		public Node parent {
			[CCode (cname = "ts_node_parent")]
			get;
		}

		/**
		 * Get the node that contains descendant.
		 *
		 * Note that this can return descendant itself.
		 */
		[CCode (cname = "ts_node_child_with_descendant")]
		public Node child_with_descendant (Node descendant);

		/**
		 * Get the node's child at the given index, where zero represents the first
		 * child.
		 */
		[CCode (cname = "ts_node_child")]
		public Node child (uint32 child_index);

		/**
		 * Get the node's number of children.
		 */
		public uint32 child_count {
			[CCode (cname = "ts_node_child_count")]
			get;
		}

		/**
		 * Get the node's named child at the given index.
		 */
		[CCode (cname = "ts_node_named_child")]
		public Node named_child (uint32 child_index);

		/**
		 * Get the node's number of named children.
		 */
		public uint32 named_child_count {
			[CCode (cname = "ts_node_named_child_count")]
			get;
		}

		/**
		 * Get the node's child with the given field name.
		 */
		[CCode (cname = "ts_node_child_by_field_name")]
		private Node _child_by_field_name ([CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] name);

		[CCode (cname = "vala_ts_node_child_by_field_name")]
		public Node child_by_field_name (string name) {
			return _child_by_field_name (name.data);
		}

		/**
		 * Get the node's child with the given numerical field id.
		 */
		[CCode (cname = "ts_node_child_by_field_id")]
		public Node child_by_field_id (FieldId field_id);

		/**
		 * Get the field name for node's child at the given index, where zero represents
		 * the first child. Returns NULL if no field is found.
		 */
		[CCode (cname = "ts_node_field_name_for_child")]
		public unowned string? field_name_for_child (uint32 child_index);

		/**
		 * Get the field name for node's named child at the given index, where zero
		 * represents the first named child. Returns NULL if no field is found.
		 */
		[CCode (cname = "ts_node_field_name_for_named_child")]
		public unowned string? field_name_for_named_child (uint32 named_child_index);

		/**
		 * Get the node's next sibling.
		 */
		public Node next_sibling {
			[CCode (cname = "ts_node_next_sibling")]
			get;
		}

		/**
		 * Get the node's previous sibling.
		 */
		public Node prev_sibling {
			[CCode (cname = "ts_node_prev_sibling")]
			get;
		}

		/**
		 * Get the node's next named sibling.
		 */
		public Node next_named_sibling {
			[CCode (cname = "ts_node_next_named_sibling")]
			get;
		}

		/**
		 * Get the node's previous named sibling.
		 */
		public Node prev_named_sibling {
			[CCode (cname = "ts_node_prev_named_sibling")]
			get;
		}

		/**
		 * Get the node's first child that contains or starts after the given byte offset.
		 */
		[CCode (cname = "ts_node_first_child_for_byte")]
		public Node first_child_for_byte (uint32 byte);

		/**
		 * Get the node's first named child that contains or starts after the given byte offset.
		 */
		[CCode (cname = "ts_node_first_named_child_for_byte")]
		public Node first_named_child_for_byte (uint32 byte);

		/**
		 * Get the node's number of descendants, including one for the node itself.
		 */
		public uint32 descendant_count {
			[CCode (cname = "ts_node_descendant_count")]
			get;
		}

		/**
		 * Get the smallest node within this node that spans the given range of bytes
		 * or (row, column) positions.
		 */
		[CCode (cname = "ts_node_descendant_for_byte_range")]
		public Node descendant_for_byte_range (uint32 start, uint32 end);

		/**
		 * Get the smallest node within this node that spans the given range of bytes
		 * or (row, column) positions.
		 */
		[CCode (cname = "ts_node_descendant_for_point_range")]
		public Node descendant_for_point_range (Point start, Point end);

		/**
		 * Get the smallest named node within this node that spans the given range of
		 * bytes or (row, column) positions.
		 */
		[CCode (cname = "ts_node_named_descendant_for_byte_range")]
		public Node named_descendant_for_byte_range (uint32 start, uint32 end);

		/**
		 * Get the smallest named node within this node that spans the given range of
		 * bytes or (row, column) positions.
		 */
		[CCode (cname = "ts_node_named_descendant_for_point_range")]
		public Node named_descendant_for_point_range (Point start, Point end);

		/**
		 * Check if two nodes are identical.
		 */
		[CCode (cname = "ts_node_eq")]
		public bool equal (Node other);

		/**
		 * Get the symbol name for this node as a null-terminated string.
		 *
		 * If a language is provided, it is used to look up the symbol; otherwise,
		 * the node's own language is used.
		 */
		[CCode (cname = "vala_ts_node_symbol_name")]
		public unowned string? symbol_name (Language? lang = null) {
			unowned Language l = lang ?? language;
			return l.symbol_name (symbol);
		}

		/**
		 * Extract the slice of the source document corresponding to this node.
		 */
		[CCode (cname = "vala_ts_node_text")]
		public string text (string source) {
			if (is_null || start_byte >= end_byte || end_byte > source.length) {
				return "";
			}
			return source.substring ((long) start_byte, (long) (end_byte - start_byte));
		}
	}

	/**
	 * A stateful cursor for walking a syntax tree efficiently.
	 *
	 * A tree cursor allows you to walk a syntax tree more efficiently than is
	 * possible using the `TSNode` functions. It is a mutable object that is always
	 * on a certain syntax node, and can be moved imperatively to different nodes.
	 */
	[CCode (cname = "TSTreeCursor", has_type_id = false, destroy_function = "ts_tree_cursor_delete")]
	public struct TreeCursor {
		private void* _tree;
		private void* _id;
		private uint32 _context[3];

		/**
		 * Create a new tree cursor starting from the given node.
		 */
		[CCode (cname = "ts_tree_cursor_reset")]
		public TreeCursor (Node node);

		/**
		 * Re-initialize a tree cursor to start at the original node that the cursor was
		 * constructed with.
		 */
		public void reset (Node node);

		/**
		 * Re-initialize a tree cursor to the same position as another cursor.
		 *
		 * Unlike `ts_tree_cursor_reset`, this will not lose parent information and
		 * allows reusing already created cursors.
		 */
		[CCode (cname = "ts_tree_cursor_reset_to")]
		public void reset_to (TreeCursor src);

		/**
		 * Get the tree cursor's current node.
		 */
		public Node current_node ();

		/**
		 * Get the field name of the tree cursor's current node.
		 */
		public unowned string? current_field_name ();

		/**
		 * Get the field id of the tree cursor's current node.
		 */
		public FieldId current_field_id ();

		/**
		 * Move the cursor to the parent of its current node.
		 */
		public bool goto_parent ();

		/**
		 * Move the cursor to the next sibling of its current node.
		 */
		public bool goto_next_sibling ();

		/**
		 * Move the cursor to the previous sibling of its current node.
		 */
		[CCode (cname = "ts_tree_cursor_goto_previous_sibling")]
		public bool goto_previous_sibling ();

		/**
		 * Move the cursor to the first child of its current node.
		 */
		public bool goto_first_child ();

		/**
		 * Move the cursor to the last child of its current node.
		 */
		[CCode (cname = "ts_tree_cursor_goto_last_child")]
		public bool goto_last_child ();

		/**
		 * Move the cursor to the node that is the nth descendant of the original node.
		 */
		[CCode (cname = "ts_tree_cursor_goto_descendant")]
		public void goto_descendant (uint32 goal_descendant_index);

		/**
		 * Get the index of the cursor's current node out of all descendants.
		 */
		[CCode (cname = "ts_tree_cursor_current_descendant_index")]
		public uint32 current_descendant_index ();

		/**
		 * Get the depth of the cursor's current node relative to the original node.
		 */
		[CCode (cname = "ts_tree_cursor_current_depth")]
		public uint32 current_depth ();

		/**
		 * Move the cursor to the first child containing or starting after the given byte offset.
		 */
		[CCode (cname = "ts_tree_cursor_goto_first_child_for_byte")]
		public int64 goto_first_child_for_byte (uint32 byte);

		/**
		 * Move the cursor to the first child containing or starting after the given point.
		 */
		[CCode (cname = "ts_tree_cursor_goto_first_child_for_point")]
		public int64 goto_first_child_for_point (Point point);

		/**
		 * Create an independent copy of the tree cursor.
		 *
		 * Note: plain assignment (`b = a`) is not supported for tree cursors and will
		 * fail to compile; always use this method.
		 */
		[CCode (cname = "vala_ts_tree_cursor_copy")]
		public TreeCursor copy () {
			TreeCursor result = {};
			result.reset_to (this);
			return result;
		}
	}

	/**
	 * A set of patterns for matching syntax nodes.
	 */
	[Compact]
	[CCode (cname = "TSQuery", has_type_id = false, free_function = "ts_query_delete")]
	public class Query {
		/**
		 * Create a new query from a string containing one or more S-expression patterns.
		 *
		 * Returns null if parsing the query failed.
		 */
		[CCode (cname = "vala_ts_query_new")]
		public static Query? create (Language language, string source, out uint32 error_offset, out QueryError error_type) {
			return _create (language, source.data, out error_offset, out error_type);
		}

		[CCode (cname = "ts_query_new")]
		private static Query? _create (Language language, [CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] source, out uint32 error_offset, out QueryError error_type);

		/**
		 * Get the number of patterns in the query.
		 */
		public uint32 pattern_count ();

		/**
		 * Get the number of captures in the query.
		 */
		public uint32 capture_count ();

		/**
		 * Get the number of string literals in the query.
		 */
		public uint32 string_count ();

		/**
		 * Get the byte offset where the given pattern starts in the query's source.
		 */
		public uint32 start_byte_for_pattern (uint32 pattern_index);

		/**
		 * Get the byte offset where the given pattern ends in the query's source.
		 */
		public uint32 end_byte_for_pattern (uint32 pattern_index);

		/**
		 * Get all of the predicates for the given pattern in the query.
		 */
		[CCode (cname = "ts_query_predicates_for_pattern", array_length_type = "uint32_t")]
		public unowned QueryPredicateStep[] predicates_for_pattern (uint32 pattern_index);

		/**
		 * Check if the given pattern in the query has a single root node.
		 */
		public bool is_pattern_rooted (uint32 pattern_index);

		/**
		 * Check if the given pattern in the query is non-local.
		 */
		public bool is_pattern_non_local (uint32 pattern_index);

		/**
		 * Check if a pattern is guaranteed to match once a given step is reached.
		 */
		public bool is_pattern_guaranteed_at_step (uint32 byte_offset);

		[CCode (cname = "ts_query_capture_name_for_id")]
		private unowned string _capture_name_for_id (uint32 id, out uint32 length);

		/**
		 * Get the name of one of the query's captures.
		 */
		[CCode (cname = "vala_ts_query_capture_name_for_id")]
		public unowned string capture_name_for_id (uint32 id) {
			uint32 length;
			return _capture_name_for_id (id, out length);
		}

		[CCode (cname = "ts_query_string_value_for_id")]
		private unowned string _string_value_for_id (uint32 id, out uint32 length);

		/**
		 * Get the value of one of the query's string literals.
		 */
		[CCode (cname = "vala_ts_query_string_value_for_id")]
		public unowned string string_value_for_id (uint32 id) {
			uint32 length;
			return _string_value_for_id (id, out length);
		}

		/**
		 * Get the quantifier of one of the query's captures.
		 */
		public Quantifier capture_quantifier_for_id (uint32 pattern_index, uint32 capture_index);

		/**
		 * Disable a certain capture within a query.
		 */
		[CCode (cname = "ts_query_disable_capture")]
		private void _disable_capture ([CCode (array_length_type = "uint32_t", type = "const char *")] uint8[] name);

		[CCode (cname = "vala_ts_query_disable_capture")]
		public void disable_capture (string name) {
			_disable_capture (name.data);
		}

		/**
		 * Disable a certain pattern within a query.
		 */
		public void disable_pattern (uint32 pattern_index);
	}

	/**
	 * A stateful cursor for executing queries on syntax nodes.
	 */
	[Compact]
	[CCode (cname = "TSQueryCursor", has_type_id = false, free_function = "ts_query_cursor_delete")]
	public class QueryCursor {
		/**
		 * Create a new query cursor.
		 */
		[CCode (cname = "ts_query_cursor_new")]
		public QueryCursor ();

		/**
		 * Start running a given query on a given node.
		 */
		public void exec (Query query, Node node);

		/**
		 * Start running a given query on a given node, with some options.
		 */
		[CCode (cname = "ts_query_cursor_exec_with_options")]
		public void exec_with_options (Query query, Node node, QueryCursorOptions query_options);

		/**
		 * Check if the query cursor exceeded its match limit.
		 */
		public bool did_exceed_match_limit ();

		/**
		 * Get the match limit of the query cursor.
		 */
		public uint32 match_limit ();

		/**
		 * Set the maximum number of in-progress matches allowed by this query cursor.
		 */
		public void set_match_limit (uint32 limit);

		/**
		 * Advance to the next match of the currently running query.
		 */
		public bool next_match (out QueryMatch match);

		/**
		 * Remove a match from the query cursor.
		 */
		public void remove_match (uint32 match_id);

		/**
		 * Advance to the next capture of the currently running query.
		 */
		public bool next_capture (out QueryMatch match, out uint32 capture_index);

		/**
		 * Set the range of bytes in which the query will be executed.
		 */
		public bool set_byte_range (uint32 start_byte, uint32 end_byte);

		/**
		 * Set the range of (row, column) positions in which the query will be executed.
		 */
		public bool set_point_range (Point start_point, Point end_point);

		/**
		 * Set the byte range within which all matches must be fully contained.
		 */
		public bool set_containing_byte_range (uint32 start_byte, uint32 end_byte);

		/**
		 * Set the point range within which all matches must be fully contained.
		 */
		public bool set_containing_point_range (Point start_point, Point end_point);

		/**
		 * Set the maximum start depth for a query cursor.
		 */
		public void set_max_start_depth (uint32 max_start_depth);
	}

	[CCode (cname = "ValaTSMallocFunc", has_typedef = false, has_target = false)]
	public delegate void* MallocFunc (size_t size);

	[CCode (cname = "ValaTSCallocFunc", has_typedef = false, has_target = false)]
	public delegate void* CallocFunc (size_t count, size_t size);

	[CCode (cname = "ValaTSReallocFunc", has_typedef = false, has_target = false)]
	public delegate void* ReallocFunc (void* ptr, size_t size);

	[CCode (cname = "ValaTSFreeFunc", has_typedef = false, has_target = false)]
	public delegate void FreeFunc (void* ptr);

	/**
	 * Set the allocation functions used by the library.
	 */
	[CCode (cname = "ts_set_allocator")]
	public static void set_allocator (
		MallocFunc? new_malloc,
		CallocFunc? new_calloc,
		ReallocFunc? new_realloc,
		FreeFunc? new_free
	);
}
